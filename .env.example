# Primary LLM Provider: Replicate (Llama 3.1)
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_MODEL_HIGH=meta/meta-llama-3.1-70b-instruct
REPLICATE_MODEL_FAST=meta/meta-llama-3.1-8b-instruct

# Fallback LLM Provider: OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_HIGH=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Application Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
